# ─────────────────────────────────────────────────────────────────────────────
# Unfold Growth — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local no git.
# ─────────────────────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=https://unfoldgrowth.com.br

# Payload CMS
# Local dev: leave empty → usa SQLite (dev.db automático)
# Produção (Neon): postgres://user:password@host/database?sslmode=require
DATABASE_URL=

# Obrigatório: gere com `openssl rand -base64 32`
PAYLOAD_SECRET=

# IA — Calculadora de Tráfego (Sprint 5)
# Modelo: claude-sonnet-4-6 | Fallback custo: claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Email transacional (Sprint 6)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@unfoldgrowth.com.br

# Anti-spam (Sprint 6)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Validação de contato (e-mail MX/DNS + WhatsApp via Evolution API) ──────
# E-mail: a checagem de MX/DNS é automática (Node), não precisa de chave.
# WhatsApp: confirma se o número tem WhatsApp ativo via Evolution API (self-host).
# Se as 3 vars abaixo estiverem vazias, a checagem de existência é PULADA
# (fail-open) — o formulário continua validando formato + 9º dígito normalmente.
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
# Defina como 'false' para desligar a checagem de existência mesmo com as vars acima.
WHATSAPP_VALIDATION_ENABLED=

# CRM — RD Station (Sprint 4/5, keys chegam do Gabriel)
RD_CRM_API_KEY=
RD_MARKETING_API_KEY=
RD_WEBHOOK_SECRET=

# ── RD Station Marketing — integração via API legacy /api/1.3/conversions ──
# Modo: mock (default, loga no console) | rd-station (envia conversões reais)
CRM_MODE=mock
# Public Token do RD Marketing → Integrações → API. Usado em todos os 3 fluxos
# (Diagnóstico, Calculadora, Newsletter). Não expira, único token necessário.
RD_STATION_PUBLIC_TOKEN=
# Private Token — reservado para chamadas server-side autenticadas (não usado hoje).
RD_STATION_PRIVATE_TOKEN=
# Webhook secret para validar callbacks RD → /api/webhooks/rd-station (HMAC SHA256).
RD_STATION_WEBHOOK_SECRET=
# Loader de rastreamento do RD Station (RD Marketing → Configurações → Script de
# monitoramento). É o UUID que aparece no src do loader:
# https://d335luupugsy2.cloudfront.net/js/loader-scripts/<UUID>-loader.js
# Injetado em todas as páginas públicas (site + Guia Eleições), só após o
# visitante aceitar cookies. Nunca no /painel nem no /admin. Fallback hardcoded
# no componente para o loader atual da Unfold.
NEXT_PUBLIC_RD_STATION_LOADER_ID=b8319393-1920-4b94-8b94-7715be209eb7

# OpenRouter — usado opcionalmente para textos AI-augmented (decisão D1)
# Modelo padrão: anthropic/claude-sonnet-4.5
OPENROUTER_API_KEY=

# Calendly — webhook signing key. URLs ficam no SiteSettings global do admin.
CALENDLY_WEBHOOK_SIGNING_KEY=

# Calendly — URL única de fallback (usada quando as URLs por faixa de Fit no
# SiteSettings estão vazias). Permite o site funcionar com uma URL única
# enquanto o Gabriel não cria slots específicos por faixa.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/gabriel-unfoldgrowth/30min

# Notificação interna do time comercial. Slack opcional.
GABRIEL_NOTIFY_EMAIL=
SLACK_WEBHOOK_GABRIEL=

# Cron — secret para chamadas externas (Vercel cron usa header próprio, não precisa)
CRON_SECRET=

# Analytics (Sprint 6)
NEXT_PUBLIC_GA4_ID=

# Sentry (Sprint 6)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Storage de mídia — Supabase Storage (S3 compatível) ─────────────────
# Onde pegar: app.supabase.com → seu projeto → Storage → Settings → "S3 Connection"
#   → "Enable connection" → copie Access Key ID + Secret Access Key
# Endpoint: https://[project-ref].supabase.co/storage/v1/s3
# Bucket: crie um bucket público chamado "media" em Storage → New bucket
# Se essas 4 vars existirem, uploads vão pro Supabase Storage automaticamente.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_BUCKET=media
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Fallback: Vercel Blob (caso não configure Supabase Storage)
# BLOB_READ_WRITE_TOKEN=

# Calendário — RD Station CRM embed URL (Sprint 4)
# Configurável via Payload Global (SiteSettings) no admin
NEXT_PUBLIC_RD_CALENDAR_URL=

# ── Hotsite "Guia Eleições 2026" (subdomínio eleicoes.unfoldgrowth.com.br/featwork) ──
# URL pública do hotsite — usada em OG/canonical/sitemap e nos UTMs de compartilhamento.
NEXT_PUBLIC_GUIA_URL=https://eleicoes.unfoldgrowth.com.br/featwork
# Identificador da conversão no RD (gatilho da automação que cria a negociação).
# DEVE bater 100% com o configurado no painel RD.
RD_GUIA_CONVERSION_ID=guia-eleicoes-2026
# Allowlist de Origin do endpoint /api/guia-eleicoes/lead (CSRF). CSV; vazio = defaults seguros.
GUIA_ALLOWED_ORIGINS=
# E-mail que recebe o alerta de fallback quando o RD falha (reprocesso manual de lead).
ALERT_EMAIL_TO=
# LGPD (opcionais — sobrescrevem os defaults do apex).
NEXT_PUBLIC_POLITICA_URL=
NEXT_PUBLIC_DPO_EMAIL=
